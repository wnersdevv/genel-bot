<%- include('../partials/kabukBasla', { guild: null, aktif: '', sayfaBaslik: 'Sistem Durumu', kullanici, config }) %>
<div style="max-width:820px;">
    <h1 class="sayfa-baslik">📡 Sistem Durumu</h1>
    <p class="sayfa-alt">Servislerin anlık durumu · <span id="sonGuncelleme">yükleniyor...</span></p>

    <div class="kart" id="genelDurum" style="margin-bottom:18px; text-align:center;">
        <div class="iskelet" style="height:60px;"></div>
    </div>

    <div class="grid" id="servisler">
        <div class="kart"><div class="iskelet" style="height:50px;"></div></div>
        <div class="kart"><div class="iskelet" style="height:50px;"></div></div>
        <div class="kart"><div class="iskelet" style="height:50px;"></div></div>
        <div class="kart"><div class="iskelet" style="height:50px;"></div></div>
    </div>

    <div class="kart" style="margin-top:18px;">
        <h3 style="margin-top:0;">ℹ️ Sistem Bilgisi</h3>
        <div id="sistemBilgi">Yükleniyor...</div>
    </div>
</div>

<script>
function satir(etiket, deger) {
    return `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:.9rem;"><span style="color:var(--text-muted);">${etiket}</span><span>${deger}</span></div>`;
}

function sureFormatla(sn) {
    const gun = Math.floor(sn / 86400), saat = Math.floor((sn % 86400) / 3600), dk = Math.floor((sn % 3600) / 60);
    return [gun && `${gun} gün`, saat && `${saat} saat`, `${dk} dakika`].filter(Boolean).join(' ');
}

async function yukle() {
    try {
        const v = await window.wnersdevApi.al('/api/genel/durum');
        const hepsiCalisiyor = v.servisler.every(s => s.çalışıyor);

        document.getElementById('genelDurum').innerHTML = `
            <div style="font-size:2.2rem;margin-bottom:6px;">${hepsiCalisiyor ? '🟢' : '🟡'}</div>
            <h2 style="margin:0 0 4px;">${hepsiCalisiyor ? 'Tüm sistemler çalışıyor' : 'Bazı servislerde sorun var'}</h2>
            <p style="color:var(--text-muted);margin:0;">Çalışma süresi: ${sureFormatla(v.çalışmaSüresiSaniye)}</p>`;

        document.getElementById('servisler').innerHTML = v.servisler.map(s => `
            <div class="kart">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <b>${s.isim}</b>
                    <span class="rozet ${s.çalışıyor ? 'rozet-yesil' : 'rozet-kirmizi'}">${s.çalışıyor ? 'Çalışıyor' : 'Sorunlu'}</span>
                </div>
                <div style="color:var(--text-muted);font-size:.82rem;margin-top:6px;">
                    ${s.gecikme !== undefined ? `Gecikme: ${s.gecikme}ms` : (s.detay || 'Aktif')}
                </div>
            </div>`).join('');

        document.getElementById('sistemBilgi').innerHTML =
            satir('Bellek Kullanımı', v.bellekMB + ' MB') +
            satir('Node.js', v.nodeVersiyon) +
            satir('discord.js', 'v' + v.discordJsVersiyon);

        document.getElementById('sonGuncelleme').textContent =
            'son güncelleme: ' + new Date(v.güncellemeZamanı).toLocaleTimeString('tr-TR');
    } catch {
        document.getElementById('genelDurum').innerHTML =
            '<div style="font-size:2.2rem;">🔴</div><h2 style="margin:6px 0;">Duruma ulaşılamıyor</h2><button class="buton" onclick="yukle()">Tekrar Dene</button>';
    }
}
yukle();
setInterval(yukle, 15000);
</script>
<%- include('../partials/kabukBitir', { guild: null }) %>
