<%- include('../partials/kabukBasla', { guild, aktif, sayfaBaslik, kullanici, config }) %>
<h1 class="sayfa-baslik">📨 Öneriler</h1>
<p class="sayfa-alt">Sunucuya gelen tüm öneriler.</p>

<div class="grid" id="oneriKartlari">
    <div class="kart istatistik-kart"><div class="baslik">🔄 Bekleyen</div><div class="deger iskelet" style="height:32px;width:50px;">&nbsp;</div></div>
    <div class="kart istatistik-kart"><div class="baslik">✅ Kabul</div><div class="deger iskelet" style="height:32px;width:50px;">&nbsp;</div></div>
    <div class="kart istatistik-kart"><div class="baslik">❌ Reddedilen</div><div class="deger iskelet" style="height:32px;width:50px;">&nbsp;</div></div>
</div>

<div class="tablo-sarici" style="margin-top:20px;">
    <table class="tablo">
        <thead><tr><th>İçerik</th><th>Gönderen</th><th>Durum</th><th>Tarih</th></tr></thead>
        <tbody id="oneriTablo"><tr><td colspan="4">Yükleniyor...</td></tr></tbody>
    </table>
</div>

<script>
(async () => {
    try {
        const veri = await window.wnersdevApi.al('/api/guild/<%= guild.id %>/oneriler');
        const kartlar = document.querySelectorAll('#oneriKartlari .deger');
        [veri.bekleyen, veri.kabul, veri.reddedilen].forEach((d, i) => { kartlar[i].classList.remove('iskelet'); kartlar[i].style = ''; kartlar[i].textContent = d; });

        const DURUM_ROZET = { bekliyor: 'rozet-sari', kabul: 'rozet-yesil', reddedildi: 'rozet-kirmizi', inceleniyor: 'rozet-mor' };
        document.getElementById('oneriTablo').innerHTML = veri.sonOneriler.length
            ? veri.sonOneriler.map(o => `<tr><td>${o.icerik.slice(0,60)}</td><td>${o.kullaniciId}</td><td><span class="rozet ${DURUM_ROZET[o.durum]}">${o.durum}</span></td><td>${window.wnersdevApi.zamanOnce(o.createdAt)}</td></tr>`).join('')
            : '<tr><td colspan="4">Henüz öneri yok.</td></tr>';
    } catch {
        document.getElementById('oneriTablo').innerHTML = '<tr><td colspan="4">❌ Yüklenemedi.</td></tr>';
    }
})();
</script>
<%- include('../partials/kabukBitir', { guild }) %>
